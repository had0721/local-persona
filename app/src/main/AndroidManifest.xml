<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      注意：这里刻意「不」申请 QUERY_ALL_PACKAGES。

      下面的 <queries> 声明可以让本应用看到所有带 android.intent.action.MAIN
      的应用（也就是所有能从桌面启动的 App），相当于绕过包可见性过滤。
      Google 对此的官方答复是 "working as intended"，它不是漏洞，是查询机制的
      设计空隙：能拿到约 87% 的已安装应用，恰好覆盖了几乎所有用户自己装的 App，
      而那些拿不到的，基本都是没有启动入口的底层系统组件。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台继续跑推理 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮窗进度条 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 应用内更新：下载新版本 APK 并调起安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PersonaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalPersona">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.LocalPersona">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.AnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
